{
  "name": "esthetics-by-anna",
  "description": "Professional esthetics website with e-commerce and booking system",
  "services": [
    {
      "name": "frontend",
      "type": "application",
      "dockerfile": "Dockerfile",
      "buildContext": ".",
      "port": 80,
      "healthcheck": {
        "endpoint": "/",
        "interval": 30,
        "timeout": 10,
        "retries": 3
      },
      "domains": [
        {
          "domain": "estheticsbyanna.com",
          "redirect": false
        }
      ],
      "environment": [
        {
          "key": "NODE_ENV",
          "value": "production"
        },
        {
          "key": "REACT_APP_API_URL",
          "value": "https://backend.estheticsbyanna.com"
        }
      ]
    },
    {
      "name": "backend",
      "type": "application",
      "dockerfile": "backend/Dockerfile",
      "buildContext": "backend",
      "port": 3001,
      "healthcheck": {
        "endpoint": "/api/health",
        "interval": 30,
        "timeout": 10,
        "retries": 3
      },
      "domains": [
        {
          "domain": "backend.estheticsbyanna.com",
          "redirect": false
        }
      ],
      "environment": [
        {
          "key": "NODE_ENV",
          "value": "production"
        },
        {
          "key": "PORT",
          "value": "3001"
        }
      ]
    },
    {
      "name": "sanity-cms",
      "type": "application",
      "dockerfile": "sanity-cms/Dockerfile",
      "buildContext": "sanity-cms",
      "port": 3333,
      "healthcheck": {
        "endpoint": "/",
        "interval": 30,
        "timeout": 10,
        "retries": 3
      },
      "domains": [
        {
          "domain": "sanity.estheticsbyanna.com",
          "redirect": false
        }
      ],
      "environment": [
        {
          "key": "NODE_ENV",
          "value": "production"
        }
      ]
    }
  ],
  "networks": {
    "default": {
      "driver": "bridge"
    }
  }
}